{
  "name": "carranco-ecommerce",
  "version": "3.0.0",
  "private": true,
  "description": "Proyecto académico Carranco: primera fase de backend e inventario MySQL",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
